{
  "name": "Michi-Neko (buildless Three.js game)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "ms-vscode.live-server"]
    },
    "codespaces": { "openFiles": ["QUICKSTART.md"] }
  },
  "postAttachCommand": "echo 'Serve the game: python3 -m http.server 8080  ·  run checks: node tools/verify.mjs'",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Michi-Neko", "onAutoForward": "openPreview" }
  }
}
